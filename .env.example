# Conta Proton (Account > OpenVPN / IKEv2 username, NAO e o login do site)
# Os 10 tuneis (vpn-1..vpn-10) usam ESSA conta. Limite Proton: 10 simultaneas.
PROTON_USER_1=troque_aqui
PROTON_PASS_1=troque_aqui
# Vazio = TODOS os paises (148). Nao liste todos: nomes com virgula
# (ex: "Palestine, State of") quebram o filtro por virgula do Gluetun.
SERVER_COUNTRIES_1=

# Opcional: 2a conta (so se expandir para vpn-11+). Hoje nao usado.
#PROTON_USER_2=troque_aqui
#PROTON_PASS_2=troque_aqui
#SERVER_COUNTRIES_2=Netherlands,Switzerland,Germany

# Roteador central: porta unica + usuarios
# formato usuario:senha (sufixo -N e automatico, nao precisa cadastrar)
ROUTER_USERS=hotel:troque_senha,otavio:troque_senha
#ROUTER_PORT=8888
#ROUTER_DEBUG=on
